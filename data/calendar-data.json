  "challenge": {
    "thema_prefix": "",
    "thema_em": "9月は「台風の季節」",
    "thema_desc": "9月は、南の海で生まれた台風が日本付近に近づきやすい時期です。台風の中心では気圧が大きく下がり、通過したあとに一気に回復します。",
    "mission_html": "複数のスクーミースポットを繋いで<strong>「台風の進路観測」</strong>をしてみよう！ 気圧が下がり始めた時刻を各地で比べると、台風がどの方向から近づいてきたのかが見えてきます。気象庁の進路図と重ねると、データと空がぴったり繋がります。",
    "mission_note": ""
  },
  "message": {
    "advisor": {
      "icon": "K",
      "role": "顧問",
      "name": "カズ先生",
      "lang": "ja",
      "text": "9月は、夏に集めたデータやアイデアを「かたちにする」月です。ダイフェスタの予選も、スクーミーデイもすぐそこ。うまくいかなかった試行錯誤こそ、いちばん強い材料になります。私はいつでも放課後スクーミー部で待ってますよ！"
    },
    "coach": {
      "icon": "M",
      "role": "コーチ",
      "name": "マット先生",
      "lang": "en",
      "text": "September is the month to look back at your summer data and ask new questions. A result you didn't expect is not a failure — it is the start of a better project. Let's keep measuring, comparing, and connecting!"
    }
  },
